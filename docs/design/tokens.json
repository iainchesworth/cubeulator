{
  "$comment": "Design tokens for Cubeulator. Source of truth for docs/design/system.md and the prototype. Checked by docs/design/tools/check_tokens.py. E2a ports these into Theme.qml.",
  "color": {
    "paper":          { "light": "#F3F2F2", "dark": "#1A1918", "use": "Window background" },
    "surface":        { "light": "#EAE9E9", "dark": "#242220", "use": "Raised or secondary pane" },
    "ink":            { "light": "#201E1D", "dark": "#F3F2F2", "use": "Primary text, icons, heavy rules" },
    "inkSecondary":   { "light": "#5E5B5A", "dark": "#B0ACAB", "use": "Secondary text. Replaces inkMuted(opacity)" },
    "inkDisabled":    { "light": "#858281", "dark": "#7A7776", "use": "Disabled labels (exempt from 4.5:1, kept at 3:1)" },
    "outline":        { "light": "#858281", "dark": "#7A7776", "use": "Boundaries of controls: secondary buttons, toggles, fields" },
    "divider":        { "light": "#C9C7C6", "dark": "#3A3836", "use": "Decorative hairlines between regions" },
    "accent":         { "light": "#EC3013", "dark": "#EC3013", "use": "Brand red. Graphics and large shapes only, never text" },
    "accentText":     { "light": "#B82009", "dark": "#FF7359", "use": "Red text and icons; eyebrow labels; links" },
    "accentFill":     { "light": "#B82009", "dark": "#FF5A3D", "use": "Primary button fill" },
    "accentFillHover":{ "light": "#A51903", "dark": "#FF6B50", "use": "Primary button, hovered" },
    "accentFillPress":{ "light": "#9E1702", "dark": "#FF7D65", "use": "Primary button, pressed" },
    "onAccent":       { "light": "#FFFFFF", "dark": "#1A1918", "use": "Label on a primary button" },
    "accentTint":     { "light": "#FFF2EF", "dark": "#3A1A14", "use": "Background of the current row or selected item" },
    "ok":             { "light": "#286F6D", "dark": "#5ABDBA", "use": "Positive state: text and icon. Teal, so it is never confused with the cube's green" },
    "caution":        { "light": "#8A5800", "dark": "#E0A030", "use": "Caution state: text and icon" },
    "hoverWash":      { "light": "#E4E2E2", "dark": "#2E2C2A", "use": "Hover fill of secondary and ghost buttons and list rows" },
    "pressWash":      { "light": "#DCDAD9", "dark": "#343230", "use": "Pressed fill of secondary and ghost buttons and list rows" },
    "cubeBody":       { "light": "#1B1A1A", "dark": "#0E0D0D", "use": "Plastic between stickers; outline of every sticker" },
    "cubeEdge":       { "light": "#201E1D", "dark": "#8C8988", "use": "Outline of a 2D sticker cell against the page" }
  },
  "overlay": {
    "$comment": "Drawn over the camera picture. The same in both themes, because the picture behind is not themed.",
    "panel":        { "value": "#141312", "alpha": 0.86, "use": "Status and control panels over the camera" },
    "ink":          { "value": "#F3F2F2", "use": "Text on a panel" },
    "inkSecondary": { "value": "#D9D6D4", "use": "Guidance text on a panel" },
    "ok":           { "value": "#5FE07A", "use": "Counting / confirmed, with a filled shape" },
    "caution":      { "value": "#FFB347", "use": "Conflict or camera trouble, with a triangle icon" },
    "outline":      { "value": "#9C9998", "use": "Empty chip border; secondary button border on a panel" },
    "scrim":        { "value": "#141312", "alpha": 0.6, "use": "Behind a dialog or sheet, on any screen" }
  },
  "cube": {
    "$comment": "Tidy swatches for the six cube colours. Tuned so the closest pair under protanopia or deuteranopia is 11.7 apart (OKLab x100) instead of 5.4. Hue is still never the only signal: each colour carries a mark. The four colours that colour-vision deficiency brings closest (yellow, orange, red, green) have the four most different marks: a hollow circle, a diagonal line, a cross and a solid dot. No mark has a direction, because a sticker is seen at any rotation.",
    "white":  { "value": "#F2F0EC", "mark": "none",     "markInk": "#201E1D" },
    "yellow": { "value": "#F6CA3F", "mark": "ring",     "markInk": "#201E1D" },
    "orange": { "value": "#F87E0F", "mark": "slash",      "markInk": "#201E1D" },
    "red":    { "value": "#CD3B37", "mark": "plus",     "markInk": "#FFFFFF" },
    "green":  { "value": "#4EB584", "mark": "dot", "markInk": "#201E1D" },
    "blue":   { "value": "#0D5792", "mark": "bar",      "markInk": "#FFFFFF" }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "6": 24, "8": 32, "12": 48, "16": 64 },
  "target": { "min": 48, "thumb": 56, "handsFull": 96 },
  "border": { "hair": 1, "rule": 2, "heavy": 3 },
  "radius": { "none": 0 },
  "type": {
    "$comment": "Sizes in rem. 1 rem = 16 px x Theme.textScale. Line height is a multiple of the size.",
    "display":     { "rem": 2.75,  "remCompact": 2.25, "weight": 800, "line": 1.0,  "family": "heading" },
    "title":       { "rem": 1.75,  "weight": 800, "line": 1.1,  "family": "heading" },
    "headline":    { "rem": 1.375, "weight": 700, "line": 1.2,  "family": "heading" },
    "instruction": { "rem": 2.0,   "weight": 800, "line": 1.1,  "family": "heading" },
    "direction":   { "rem": 1.5,   "weight": 700, "line": 1.15, "family": "heading" },
    "body":        { "rem": 1.0,   "weight": 400, "line": 1.45, "family": "heading" },
    "bodyStrong":  { "rem": 1.0,   "weight": 700, "line": 1.45, "family": "heading" },
    "small":       { "rem": 0.875, "weight": 400, "line": 1.45, "family": "heading" },
    "label":       { "rem": 1.0,   "remGiant": 1.25, "weight": 800, "line": 1.2,  "family": "heading" },
    "eyebrow":     { "rem": 0.8125,"weight": 700, "line": 1.2,  "family": "heading", "tracking": 0.1, "caps": true },
    "numeral":     { "rem": 1.0,   "weight": 500, "line": 1.2,  "family": "mono" },
    "numeralLarge":{ "rem": 2.0,   "weight": 500, "line": 1.1,  "family": "mono" }
  },
  "sizeClass": {
    "width":  { "compact": [0, 599], "medium": [600, 839], "expanded": [840, null] },
    "height": { "short": [0, 479], "regular": [480, null] }
  },
  "motion": {
    "$comment": "Milliseconds. 'reduced' is what the same token becomes when motion is reduced.",
    "instant": { "full": 0,   "reduced": 0 },
    "quick":   { "full": 120, "reduced": 0 },
    "base":    { "full": 200, "reduced": 0 },
    "screen":  { "full": 280, "reduced": 120, "note": "Screen change. Reduced: opacity cross-fade only" },
    "turn":    { "full": 380, "reduced": 0,   "note": "One layer turn. Solve lane owns it. Reduced: snap, with a static arrow" }
  },
  "pairs": [
    ["ink", "paper", 4.5, "Body text"],
    ["ink", "surface", 4.5, "Body text on a pane"],
    ["ink", "accentTint", 4.5, "Text in the current row"],
    ["ink", "hoverWash", 4.5, "Label on a hovered secondary button or row"],
    ["ink", "pressWash", 4.5, "Label on a pressed secondary button or row"],
    ["inkSecondary", "paper", 4.5, "Secondary text"],
    ["inkSecondary", "surface", 4.5, "Secondary text on a pane"],
    ["inkSecondary", "accentTint", 4.5, "Secondary text in the current row"],
    ["inkSecondary", "hoverWash", 4.5, "Secondary text in a hovered row"],
    ["accentText", "paper", 4.5, "Eyebrow, link, ghost button label"],
    ["accentText", "surface", 4.5, "Eyebrow, link on a pane"],
    ["accentText", "accentTint", 4.5, "Accent text in the current row"],
    ["accentText", "hoverWash", 4.5, "Ghost button label, hovered"],
    ["accentText", "pressWash", 4.5, "Ghost button label, pressed"],
    ["onAccent", "accentFill", 4.5, "Primary button label"],
    ["onAccent", "accentFillHover", 4.5, "Primary button label, hovered"],
    ["onAccent", "accentFillPress", 4.5, "Primary button label, pressed"],
    ["ok", "paper", 4.5, "Positive text and icon"],
    ["ok", "surface", 4.5, "Positive text and icon on a pane"],
    ["caution", "paper", 4.5, "Caution text and icon"],
    ["caution", "surface", 4.5, "Caution text and icon on a pane"],
    ["accentFill", "paper", 3.0, "Primary button against the page"],
    ["accentFill", "surface", 3.0, "Primary button against a pane"],
    ["accent", "paper", 3.0, "Brand graphics, progress fill, turn arrow"],
    ["accent", "surface", 3.0, "Brand graphics on a pane"],
    ["outline", "paper", 3.0, "Control boundary"],
    ["outline", "surface", 3.0, "Control boundary on a pane"],
    ["outline", "accentTint", 3.0, "Control boundary in the current row"],
    ["inkDisabled", "paper", 3.0, "Disabled label (exempt; held at 3:1 anyway)"],
    ["ink", "paper", 3.0, "Focus ring outer band against the page"],
    ["cubeEdge", "paper", 3.0, "Sticker outline against the page"],
    ["cubeEdge", "surface", 3.0, "Sticker outline against a pane"]
  ]
}
