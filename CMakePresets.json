{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/deps/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "fastdebug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "profiling",
      "hidden": true,
      "inherits": ["fastdebug"],
      "cacheVariables": {
        "CUBEULATOR_ENABLE_TRACY": "ON",
        "CUBEULATOR_ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "windows-msvc-base",
      "hidden": true,
      "inherits": ["base"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows (MSVC, Debug)",
      "inherits": ["windows-msvc-base", "debug"]
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows (MSVC, Release)",
      "inherits": ["windows-msvc-base", "release"]
    },
    {
      "name": "windows-msvc-fastdebug",
      "displayName": "Windows (MSVC, Fast Debug - optimized, no sanitizers, debug info)",
      "inherits": ["windows-msvc-base", "fastdebug"]
    },
    {
      "name": "windows-msvc-profiling",
      "displayName": "Windows (MSVC, Profiling - optimized, debug info, Tracy)",
      "inherits": ["windows-msvc-base", "profiling"]
    },
    {
      "name": "linux-gcc-base",
      "hidden": true,
      "inherits": ["base"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux (GCC, Debug)",
      "inherits": ["linux-gcc-base", "debug"]
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux (GCC, Release)",
      "inherits": ["linux-gcc-base", "release"]
    },
    {
      "name": "linux-gcc-fastdebug",
      "displayName": "Linux (GCC, Fast Debug - optimized, no sanitizers, debug info)",
      "inherits": ["linux-gcc-base", "fastdebug"]
    },
    {
      "name": "linux-gcc-profiling",
      "displayName": "Linux (GCC, Profiling - optimized, debug info, Tracy)",
      "inherits": ["linux-gcc-base", "profiling"]
    },
    {
      "name": "linux-gcc-coverage",
      "displayName": "Linux (GCC, Coverage)",
      "inherits": ["linux-gcc-base", "debug"],
      "cacheVariables": {
        "CUBEULATOR_ENABLE_COVERAGE": "ON",
        "CUBEULATOR_ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "macos-clang-base",
      "hidden": true,
      "inherits": ["base"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    },
    {
      "name": "macos-clang-debug",
      "displayName": "macOS (AppleClang, Debug)",
      "inherits": ["macos-clang-base", "debug"]
    },
    {
      "name": "macos-clang-release",
      "displayName": "macOS (AppleClang, Release)",
      "inherits": ["macos-clang-base", "release"]
    },
    {
      "name": "macos-clang-fastdebug",
      "displayName": "macOS (AppleClang, Fast Debug - optimized, no sanitizers, debug info)",
      "inherits": ["macos-clang-base", "fastdebug"]
    },
    {
      "name": "macos-clang-profiling",
      "displayName": "macOS (AppleClang, Profiling - optimized, debug info, Tracy)",
      "inherits": ["macos-clang-base", "profiling"]
    },
    {
      "name": "android-clang-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/deps/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_TARGET_TRIPLET": "arm64-android",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-28",
        "CUBEULATOR_BUILD_TESTS": "OFF",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF"
      }
    },
    {
      "name": "android-clang-debug",
      "displayName": "Android (arm64-v8a, Debug)",
      "inherits": ["android-clang-base", "debug"]
    },
    {
      "name": "android-clang-release",
      "displayName": "Android (arm64-v8a, Release)",
      "inherits": ["android-clang-base", "release"]
    },
    {
      "name": "ios-clang-base",
      "hidden": true,
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "toolchainFile": "${sourceDir}/deps/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-ios",
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "18.0",
        "CUBEULATOR_BUILD_APP": "OFF",
        "CUBEULATOR_BUILD_TESTS": "OFF",
        "CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED": "NO",
        "CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_REQUIRED": "NO",
        "CMAKE_XCODE_ATTRIBUTE_CODE_SIGN_IDENTITY": ""
      }
    },
    {
      "name": "ios-clang-debug",
      "displayName": "iOS (device, Debug)",
      "inherits": ["ios-clang-base", "debug"]
    },
    {
      "name": "ios-clang-release",
      "displayName": "iOS (device, Release)",
      "inherits": ["ios-clang-base", "release"]
    },
    {
      "name": "web-emscripten-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/deps/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_TARGET_TRIPLET": "wasm32-emscripten-threads",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{QT_ROOT_DIR}/lib/cmake/Qt6/qt.toolchain.cmake",
        "CUBEULATOR_BUILD_TESTS": "OFF",
        "CUBEULATOR_ENABLE_SANITIZERS": "OFF",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF"
      }
    },
    {
      "name": "web-emscripten-debug",
      "displayName": "Web (WebAssembly, Debug)",
      "inherits": ["web-emscripten-base", "debug"]
    },
    {
      "name": "web-emscripten-release",
      "displayName": "Web (WebAssembly, Release)",
      "inherits": ["web-emscripten-base", "release"]
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug" },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release" },
    { "name": "windows-msvc-fastdebug", "configurePreset": "windows-msvc-fastdebug" },
    { "name": "windows-msvc-profiling", "configurePreset": "windows-msvc-profiling" },
    { "name": "linux-gcc-debug", "configurePreset": "linux-gcc-debug" },
    { "name": "linux-gcc-release", "configurePreset": "linux-gcc-release" },
    { "name": "linux-gcc-fastdebug", "configurePreset": "linux-gcc-fastdebug" },
    { "name": "linux-gcc-profiling", "configurePreset": "linux-gcc-profiling" },
    { "name": "linux-gcc-coverage", "configurePreset": "linux-gcc-coverage" },
    { "name": "macos-clang-debug", "configurePreset": "macos-clang-debug" },
    { "name": "macos-clang-release", "configurePreset": "macos-clang-release" },
    { "name": "macos-clang-fastdebug", "configurePreset": "macos-clang-fastdebug" },
    { "name": "macos-clang-profiling", "configurePreset": "macos-clang-profiling" },
    { "name": "android-clang-debug", "configurePreset": "android-clang-debug" },
    { "name": "android-clang-release", "configurePreset": "android-clang-release" },
    { "name": "ios-clang-debug", "configurePreset": "ios-clang-debug" },
    { "name": "ios-clang-release", "configurePreset": "ios-clang-release" },
    { "name": "web-emscripten-debug", "configurePreset": "web-emscripten-debug" },
    { "name": "web-emscripten-release", "configurePreset": "web-emscripten-release" }
  ],
  "testPresets": [
    {
      "name": "common",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "base",
      "description": "Everything except the system tests, which draw the real app in a window (docs/testing.md). Local presets inherit this one.",
      "hidden": true,
      "inherits": "common",
      "filter": {
        "exclude": { "label": "system" }
      }
    },
    {
      "name": "base-system",
      "description": "Only the system tests. A command-line -L cannot widen a preset that excludes the label, so they have presets of their own: <preset>-system.",
      "hidden": true,
      "inherits": "common",
      "filter": {
        "include": { "label": "system" }
      }
    },
    { "name": "windows-msvc-debug", "inherits": "base", "configurePreset": "windows-msvc-debug" },
    { "name": "windows-msvc-release", "inherits": "base", "configurePreset": "windows-msvc-release" },
    { "name": "windows-msvc-fastdebug", "inherits": "base", "configurePreset": "windows-msvc-fastdebug" },
    { "name": "windows-msvc-profiling", "inherits": "base", "configurePreset": "windows-msvc-profiling" },
    { "name": "linux-gcc-debug", "inherits": "base", "configurePreset": "linux-gcc-debug" },
    { "name": "linux-gcc-release", "inherits": "base", "configurePreset": "linux-gcc-release" },
    { "name": "linux-gcc-fastdebug", "inherits": "base", "configurePreset": "linux-gcc-fastdebug" },
    { "name": "linux-gcc-profiling", "inherits": "base", "configurePreset": "linux-gcc-profiling" },
    { "name": "linux-gcc-coverage", "inherits": "base", "configurePreset": "linux-gcc-coverage" },
    { "name": "macos-clang-debug", "inherits": "base", "configurePreset": "macos-clang-debug" },
    { "name": "macos-clang-release", "inherits": "base", "configurePreset": "macos-clang-release" },
    { "name": "macos-clang-fastdebug", "inherits": "base", "configurePreset": "macos-clang-fastdebug" },
    { "name": "macos-clang-profiling", "inherits": "base", "configurePreset": "macos-clang-profiling" },
    { "name": "windows-msvc-debug-system", "inherits": "base-system", "configurePreset": "windows-msvc-debug" },
    { "name": "windows-msvc-release-system", "inherits": "base-system", "configurePreset": "windows-msvc-release" },
    { "name": "windows-msvc-fastdebug-system", "inherits": "base-system", "configurePreset": "windows-msvc-fastdebug" },
    { "name": "windows-msvc-profiling-system", "inherits": "base-system", "configurePreset": "windows-msvc-profiling" },
    { "name": "linux-gcc-debug-system", "inherits": "base-system", "configurePreset": "linux-gcc-debug" },
    { "name": "linux-gcc-release-system", "inherits": "base-system", "configurePreset": "linux-gcc-release" },
    { "name": "linux-gcc-fastdebug-system", "inherits": "base-system", "configurePreset": "linux-gcc-fastdebug" },
    { "name": "linux-gcc-profiling-system", "inherits": "base-system", "configurePreset": "linux-gcc-profiling" },
    { "name": "linux-gcc-coverage-system", "inherits": "base-system", "configurePreset": "linux-gcc-coverage" },
    { "name": "macos-clang-debug-system", "inherits": "base-system", "configurePreset": "macos-clang-debug" },
    { "name": "macos-clang-release-system", "inherits": "base-system", "configurePreset": "macos-clang-release" },
    { "name": "macos-clang-fastdebug-system", "inherits": "base-system", "configurePreset": "macos-clang-fastdebug" },
    { "name": "macos-clang-profiling-system", "inherits": "base-system", "configurePreset": "macos-clang-profiling" }
  ]
}
