# write only when changed so dependants do not rebuild for nothing
function(cn_write_if_changed path content)
    set(existing "")
    if(EXISTS "${path}")
        file(READ "${path}" existing)
    endif()
    if(NOT existing STREQUAL content)
        file(WRITE "${path}" "${content}")
    endif()
endfunction()
cn_write_if_changed("${_json_out}" "${_json}")
cn_write_if_changed("${_txt_out}" "${_txt}")

